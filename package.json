{
  "name": "kontado",
  "description": "Kontado is a platform for tracking and managing bills and expenses",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint src/",
    "postinstall": "npx prisma generate",
    "version-major": "npm version major",
    "version-minor": "npm version minor",
    "version-patch": "npm version patch",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx scripts/generate-test-data.ts",
    "db:update": "./scripts/update-db.sh deploy",
    "db:update:dev": "./scripts/update-db.sh dev",
    "db:update:seed": "./scripts/update-db.sh deploy --seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.3",
    "react-hot-toast": "^2.6.0",
    "react-resizable": "^3.1.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.10",
    "beasties": "0.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "openapi-typescript-codegen": "^0.30.0",
    "prisma": "^7.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}
