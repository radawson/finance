{
  "name": "kontado",
  "description": "Kontado is a platform for tracking and managing bills and expenses",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint src/",
    "test": "jest",
    "test:e2e": "playwright test",
    "postinstall": "npx prisma generate",
    "version-major": "npm version major",
    "version-minor": "npm version minor",
    "version-patch": "npm version patch",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx scripts/generate-test-data.ts",
    "db:update": "./scripts/update-db.sh deploy",
    "db:update:dev": "./scripts/update-db.sh dev",
    "db:update:seed": "./scripts/update-db.sh deploy --seed",
    "db:backfill-ledger": "tsx scripts/backfill-ledger.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4",
    "react-hot-toast": "^2.6.0",
    "react-resizable": "^3.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.23",
    "beasties": "0.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "openapi-typescript-codegen": "^0.31.0",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "@types/pg": "$@types/pg"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "allowScripts": {
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.11.1": true,
    "@prisma/engines@7.8.0": true
  }
}
